# Copy to .env (gitignored) with scripts/make_env.py, which fills random values.
# Never put real secrets in this file or in any SKILL.md, prompt, config or log.

# Gateway auth token for the OpenClaw Control UI / CLI (random, local only)
OPENCLAW_GATEWAY_TOKEN=

# Admin token for the synthetic CRM approval API. Held by the human's shell and the CRM
# container only. The OpenClaw container never receives it.
CRM_ADMIN_TOKEN=

# Fake "canary" secret placed in the OpenClaw container's environment. It has no power.
# tests/test_canary.py fails if this value (or an encoding of it) appears anywhere in
# transcripts, logs, CRM data, proxy logs or harness outputs.
DATAROOM_API_KEY=
